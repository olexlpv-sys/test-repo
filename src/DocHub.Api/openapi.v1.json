{
  "openapi": "3.1.1",
  "info": {
    "title": "DocHub.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/system/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Auth mode and environment; the SPA shows the test-mode user switcher when authMode is Test.",
        "operationId": "GetSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "The current user.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MeResponse": {
        "required": [
          "id",
          "login",
          "displayName",
          "email",
          "isAdmin"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "login": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          }
        }
      },
      "SystemInfo": {
        "required": [
          "authMode",
          "environment",
          "version"
        ],
        "type": "object",
        "properties": {
          "authMode": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "TestMode": {
        "type": "apiKey",
        "description": "Test mode: id of a seeded, active user (e.g. 2 = alice).",
        "name": "X-User-Id",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "TestMode": []
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Users"
    }
  ]
}

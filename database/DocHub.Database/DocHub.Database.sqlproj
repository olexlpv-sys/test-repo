<Project Sdk="Microsoft.Build.Sql/2.3.0">

  <PropertyGroup>
    <Name>DocHub.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <CompatibilityMode>160</CompatibilityMode>
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
    <SqlServerVerification>False</SqlServerVerification>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
  </PropertyGroup>

  <ItemGroup>
    <Build Remove="Scripts\**\*.sql" />
    <PostDeploy Include="Scripts\PostDeployment\Script.PostDeployment.sql" />
    <None Include="Scripts\PostDeployment\*.sql" Exclude="Scripts\PostDeployment\Script.PostDeployment.sql" />
  </ItemGroup>

</Project>
